{
  "vars": {
    "data_dir": "data",
    "wp_content_dir": "wp-content"
  },
  "files": {
    "no_wildcards_match_slash": true,
    "excludes": [
      "./tmp/*",
      "./mariadb/*",
      "./mariadb-backup/*",
      "./{data_dir}/wp-admin/*",
      "./{data_dir}/wp-includes/*",
      "./{data_dir}/index.php",
      "./{data_dir}/wp-activate.php",
      "./{data_dir}/wp-blog-header.php",
      "./{data_dir}/wp-comments-post.php",
      "./{data_dir}/wp-config-sample.php",
      "./{data_dir}/wp-config-docker.php",
      "./{data_dir}/wp-cron.php",
      "./{data_dir}/wp-links-opml.php",
      "./{data_dir}/wp-load.php",
      "./{data_dir}/wp-login.php",
      "./{data_dir}/wp-mail.php",
      "./{data_dir}/wp-settings.php",
      "./{data_dir}/wp-signup.php",
      "./{data_dir}/wp-trackback.php",
      "./{data_dir}/xmlrpc.php",
      "./{data_dir}/{wp_content_dir}/upgrade/*",
      "./{data_dir}/{wp_content_dir}/upgrade-temp-backup/*",
      "*.tmp"
    ]
  },
  "dac": [
    { "path": ".", "owner": "root:stack", "dir_mode": "0750" },
    { "path": "docker-compose.yaml", "owner": "root:root", "file_mode": "0600" },
    { "path": ".env", "owner": "root:root", "file_mode": "0600", "optional": true },
    { "path": "wordpress.env", "owner": "root:root", "file_mode": "0600", "optional": true },
    { "path": "notifier.env", "owner": "root:root", "file_mode": "0600", "optional": true },
    { "path": "mariadb-backup", "owner": "root:root", "dir_mode": "0700", "file_mode": "0600", "recursive": true, "optional": true },
    { "path": "config", "owner": "root:stack", "dir_mode": "0750", "file_mode": "0640", "recursive": true, "optional": true },
    { "path": "secrets", "owner": "root:stack", "dir_mode": "0750", "file_mode": "0440", "recursive": true, "optional": true },
    { "path": "snippets", "owner": "root:stack", "dir_mode": "0750", "file_mode": "0640", "recursive": true, "optional": true },
    { "path": ".wp-cli", "owner": "stack:stack", "dir_mode": "0700", "file_mode": "0600", "recursive": true, "optional": true },
    { "path": "mariadb", "owner": "stack:stack", "dir_mode": "0700", "file_mode": "0600", "recursive": true, "optional": true },
    { "path": "tmp", "owner": "stack:stack", "dir_mode": "0700", "file_mode": "0600", "recursive": true, "optional": true },
    { "path": "{data_dir}", "owner": "stack:stack", "dir_mode": "0700", "file_mode": "0600", "recursive": true },
    { "path": "{data_dir}/{wp_content_dir}/mu-plugins/sbs-loader.php", "owner": "root:stack", "file_mode": "0440", "optional": true }
  ],
  "host_files": [
    { "path": "/etc/cron.d/wordpress-{stack}", "owner": "root:root", "file_mode": "0644", "optional": true }
  ],
  "databases": [
    {
      "driver": "wp-cli",
      "service": "wp-cli"
    }
  ],
  "restore_steps": [
    { "action": "compose_down" },
    { "action": "extract_files" },
    { "action": "apply_dac" },
    { "action": "extract_host_files" },
    { "action": "deploy_reverse_proxy" },
    { "action": "compose_up" },
    { "action": "wait_healthy" },
    { "action": "db_import" },
    { "action": "compose_restart" },
    { "action": "wait_healthy" },
    { "action": "compose_run", "service": "wp-cli", "args": ["cache", "flush"] },
    { "action": "compose_run", "service": "wp-cli", "args": ["rewrite", "flush"] }
  ]
}
