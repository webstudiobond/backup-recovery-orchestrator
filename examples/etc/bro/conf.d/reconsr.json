{
  "enabled": true,
  "user": { "name": "reconsr", "uid": 1007, "gid": 1007 },
  "files": {
    "no_wildcards_match_slash": true,
    "excludes": [
      "./data/ip2location/*",
      "./data/maxmind/*",
      "./logs/*",
      "./reports/*",
      "./storage/*",
      "*.tmp"
    ]
  },
  "dac": [
    { "path": ".", "owner": "root:stack", "dir_mode": "0750" },
    { "path": "docker-compose.yaml", "owner": "root:root", "file_mode": "0600" },
    { "path": ".env", "owner": "root:root", "file_mode": "0600" },
    { "path": "configs", "owner": "stack:stack", "dir_mode": "0700", "file_mode": "0600", "recursive": true },
    { "path": "configs", "owner": "root:stack", "dir_mode": "0750" },
    { "path": "configs/keys.txt", "owner": "root:stack", "file_mode": "0640", "optional": true },
    { "path": "secrets", "owner": "root:stack", "dir_mode": "0750", "file_mode": "0440", "recursive": true, "optional": true },
    { "path": "data", "owner": "stack:stack", "dir_mode": "0700", "file_mode": "0400", "recursive": true },
    { "path": "logs", "owner": "stack:stack", "dir_mode": "0700", "file_mode": "0600", "recursive": true, "optional": true },
    { "path": "storage", "owner": "stack:stack", "dir_mode": "0700", "file_mode": "0600", "recursive": true },
    { "path": "lang", "owner": "stack:stack", "dir_mode": "0700", "file_mode": "0600", "recursive": true },
    { "path": "reports", "owner": "stack:stack", "dir_mode": "0700", "file_mode": "0600", "recursive": true }
  ],
  "restore_steps": [
    { "action": "compose_down" },
    { "action": "extract_files" },
    { "action": "apply_dac" }
  ]
}
