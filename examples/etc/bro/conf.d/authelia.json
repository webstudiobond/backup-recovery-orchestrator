{
  "enabled": true,
  "user": { "name": "authelia", "uid": 1003, "gid": 1003 },
  "files": {
    "no_wildcards_match_slash": true,
    "excludes": [
      "./logs/*",
      "*.tmp"
    ]
  },
  "dac": [
    { "path": ".", "owner": "root:stack", "dir_mode": "0750" },
    { "path": "docker-compose.yaml", "owner": "root:root", "file_mode": "0600" },
    { "path": ".env", "owner": "root:root", "file_mode": "0600" },
    { "path": "config", "owner": "root:stack", "dir_mode": "0750", "file_mode": "0640", "recursive": true },
    { "path": "secrets", "owner": "root:stack", "dir_mode": "0750", "file_mode": "0440", "recursive": true },
    { "path": "data", "owner": "stack:stack", "dir_mode": "0700", "file_mode": "0600", "recursive": true },
    { "path": "logs", "owner": "stack:stack", "dir_mode": "0700", "file_mode": "0600", "recursive": true }
  ],
  "host_files": [
    { "path": "/etc/logrotate.d/authelia", "owner": "root:root", "file_mode": "0400", "optional": true }
  ],
  "reverse_proxy": {
    "acme_names": ["example"],
    "domain_confs": ["example.com.conf"]
  },
  "restore_steps": [
    { "action": "compose_down" },
    { "action": "extract_files" },
    { "action": "apply_dac" },
    { "action": "extract_host_files" },
    { "action": "deploy_reverse_proxy" },
    { "action": "compose_up" },
    { "action": "wait_healthy" }
  ]
}
