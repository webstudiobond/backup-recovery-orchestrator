{
  "enabled": true,
  "user": { "name": "dns", "uid": 1004, "gid": 1004 },
  "files": {
    "excludes": [
      "*.tmp"
    ]
  },
  "dac": [
    { "path": ".", "owner": "root:stack", "dir_mode": "0750" },
    { "path": "docker-compose.yaml", "owner": "root:root", "file_mode": "0600" },
    { "path": ".env", "owner": "root:root", "file_mode": "0600" },
    { "path": "secrets", "owner": "root:stack", "dir_mode": "0750", "file_mode": "0440", "recursive": true },
    { "path": "data", "owner": "stack:stack", "dir_mode": "0700", "file_mode": "0600", "recursive": true }
  ],
  "host_files": [
    { "path": "/usr/local/bin/angie_cert_sync.sh", "owner": "root:root", "file_mode": "0500", "optional": true },
    { "path": "/etc/systemd/system/angie-cert-sync.service", "owner": "root:root", "file_mode": "0644", "optional": true },
    { "path": "/etc/systemd/system/angie-cert-sync.path", "owner": "root:root", "file_mode": "0644", "optional": true },
    { "path": "/etc/default/angie-cert-sync", "owner": "root:root", "file_mode": "0600", "optional": true },
    { "path": "/etc/sysctl.d/99-net-buffers.conf", "owner": "root:root", "file_mode": "0644", "optional": true }
  ],
  "reverse_proxy": {
    "domain_confs": ["adguardhome.conf"]
  },
  "restore_steps": [
    { "action": "compose_down" },
    { "action": "extract_files" },
    { "action": "apply_dac" },
    { "action": "extract_host_files" },
    { "action": "deploy_reverse_proxy" },
    { "action": "compose_up" },
    { "action": "wait_healthy" }
  ]
}
