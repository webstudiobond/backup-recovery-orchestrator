{
  "enabled": true,
  "user": { "name": "mihomo", "uid": 1006, "gid": 1006 },
  "files": {
    "excludes": [
      "*.tmp"
    ]
  },
  "dac": [
    { "path": ".", "owner": "root:stack", "dir_mode": "0750" },
    { "path": "docker-compose.yaml", "owner": "root:root", "file_mode": "0600" },
    { "path": ".env", "owner": "root:root", "file_mode": "0600" },
    { "path": "secrets", "owner": "root:stack", "dir_mode": "0750", "file_mode": "0440", "recursive": true },
    { "path": "data", "owner": "stack:stack", "dir_mode": "0700", "file_mode": "0600", "recursive": true },
    { "path": "wgcf", "owner": "stack:stack", "dir_mode": "0700", "file_mode": "0600", "recursive": true }
  ],
  "angie": {
    "acme_names": ["example"],
    "domain_confs": ["example.com.conf"]
  },
  "restore_steps": [
    { "action": "compose_down" },
    { "action": "extract_files" },
    { "action": "apply_dac" },
    { "action": "deploy_angie" },
    { "action": "compose_up" },
    { "action": "wait_healthy" }
  ]
}
