{
  "enabled": true,
  "user": { "name": "matrix", "uid": 1005, "gid": 1005 },
  "hooks": {
    "pre_snapshot": [
      { "action": "remove_path", "path": "/home/matrix/tuwunel/data/backup_checkpoint" },
      { "action": "compose_kill", "service": "tuwunel", "signal": "USR2" },
      { "action": "wait_for_file", "path": "/home/matrix/tuwunel/data/backup_checkpoint/CURRENT", "timeout_sec": 60 }
    ],
    "post_snapshot": [
      { "action": "remove_path", "path": "/home/matrix/tuwunel/data/backup_checkpoint" }
    ]
  },
  "files": {
    "no_wildcards_match_slash": true,
    "excludes": [
      "./tuwunel/data/archive/*",
      "./tuwunel/data/CURRENT",
      "./tuwunel/data/IDENTITY",
      "./tuwunel/data/LOCK",
      "./tuwunel/data/LOG",
      "./tuwunel/data/LOG.old.*",
      "./tuwunel/data/MANIFEST-*",
      "./tuwunel/data/OPTIONS-*",
      "./tuwunel/data/*.sst",
      "./tuwunel/data/*.log",
      "./tuwunel/data/*.dbtmp",
      "./tuwunel/data/backup_checkpoint.tmp*",
      "*.tmp"
    ]
  },
  "dac": [
    { "path": ".", "owner": "root:stack", "dir_mode": "0750" },
    { "path": "docker-compose.yaml", "owner": "root:root", "file_mode": "0600" },
    { "path": ".env", "owner": "root:root", "file_mode": "0600" },
    { "path": "secrets", "owner": "root:stack", "dir_mode": "0750", "file_mode": "0440", "recursive": true },
    { "path": "element-web", "owner": "stack:stack", "dir_mode": "0700", "file_mode": "0600", "recursive": true },
    { "path": "element-web/.env", "owner": "root:root", "file_mode": "0600" },
    { "path": "livekit", "owner": "stack:stack", "dir_mode": "0700", "file_mode": "0600", "recursive": true },
    { "path": "livekit/.env", "owner": "root:root", "file_mode": "0600" },
    { "path": "lk-jwt-service", "owner": "stack:stack", "dir_mode": "0700", "file_mode": "0600", "recursive": true },
    { "path": "lk-jwt-service/.env", "owner": "root:root", "file_mode": "0600" },
    { "path": "tuwunel", "owner": "stack:stack", "dir_mode": "0700", "file_mode": "0600", "recursive": true },
    { "path": "tuwunel/.env", "owner": "root:root", "file_mode": "0600" },
    { "path": "telegram", "owner": "stack:stack", "dir_mode": "0700", "file_mode": "0600", "recursive": true },
    { "path": "valkey", "owner": "stack:stack", "dir_mode": "0700", "file_mode": "0600", "recursive": true }
  ],
  "reverse_proxy": {
    "acme_names": ["matrix", "element", "livekit", "matrix_rtc"],
    "domain_confs": ["matrix.example.com.conf", "element.example.net.conf", "livekit.example.org.conf"],
    "stream_confs": ["livekit-turn.inc"]
  },
  "restore_steps": [
    { "action": "compose_down" },
    { "action": "extract_files" },
    { "action": "move_contents", "from": "tuwunel/data/backup_checkpoint", "to": "tuwunel/data" },
    { "action": "apply_dac" },
    { "action": "deploy_reverse_proxy" },
    { "action": "compose_up" },
    { "action": "wait_healthy", "timeout_sec": 600 }
  ]
}
